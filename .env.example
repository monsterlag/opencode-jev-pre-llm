# OpenCode JEV Pre-LLM Plugin
# Copie este arquivo para .env na sua máquina (git.ignore o .env real)

# API KEY
JEV_API_KEY=sk-xxx

# Endpoint / configuração da API
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Thresholds
JEV_THRESHOLD=0.8        # noul (0..1) ≥ threshold
JEV_MIN_CONFIDENCE=1.0   # score (0..2) ≥ min

# Segurança
JEV_TIMEOUT_MS=3000      # aborta o fetch após este ms
JEV_MAX_TOKENS=400       # tokens injetados no system prompt

# Opções avançadas (prefixo opcional)
JEV_SMOKE=0              # 1 = faz uma chamada à API real na inicialização (verificação)
JEV_CACHE_TTL_MS=600_000 # tempo de vida do cache do veredito (10 min)
JEV_LOG_LEVEL=info       # logs via console

# Sobrescreve .env
OPENCODE_JEV_CONFIG='{ "threshold": 0.9, "confidence": 1.2 }' # JSON opcional